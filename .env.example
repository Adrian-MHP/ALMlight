# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# Port on the host for the web app
ALMLIGHT_PORT=48080

# Database password (used by both containers)
POSTGRES_PASSWORD=change-me

# Session signing key. Leave empty to generate one automatically (persisted in the data volume).
ALMLIGHT_SECRET_KEY=

# Initial administrator password for a fresh installation. Leave empty to generate one (printed to the log once).
ALMLIGHT_ADMIN_PASSWORD=

# Load the demo project and demo users on startup (not for production)
ALMLIGHT_DEMO_DATA=false
# On a server others can reach: false = the demo users get passwords nobody knows (they cannot sign in)
ALMLIGHT_DEMO_SIGN_IN=true
# viewer | contributor | reviewer = every signed-in user can open the demo project with that role; empty = members only
ALMLIGHT_DEMO_OPEN_ROLE=

# Sign-in protection: failed attempts per user name within the window block further attempts (0 = off)
ALMLIGHT_LOGIN_MAX_FAILURES=10
ALMLIGHT_LOGIN_WINDOW_SECONDS=900

# Set to true when served via HTTPS (reverse proxy)
ALMLIGHT_COOKIE_SECURE=false

ALMLIGHT_MAX_UPLOAD_MB=100

# Public address of the app (links in notification e-mails, single sign-on redirect), e.g. https://alm.example.com
ALMLIGHT_PUBLIC_URL=

# Notification e-mails (digest). Off unless SMTP_HOST and SMTP_FROM are set. SMTP_SECURITY: starttls | ssl | none
ALMLIGHT_SMTP_HOST=
ALMLIGHT_SMTP_PORT=587
ALMLIGHT_SMTP_USER=
ALMLIGHT_SMTP_PASSWORD=
ALMLIGHT_SMTP_FROM=
ALMLIGHT_SMTP_SECURITY=starttls

# Single sign-on via OpenID Connect (Microsoft Entra ID, Keycloak, Okta …). Off unless issuer and client id are set.
# Redirect URI to register at the identity provider: <ALMLIGHT_PUBLIC_URL>/api/v1/auth/oidc/callback
ALMLIGHT_OIDC_ISSUER=
ALMLIGHT_OIDC_CLIENT_ID=
ALMLIGHT_OIDC_CLIENT_SECRET=
ALMLIGHT_OIDC_LABEL=Single sign-on
# Members of this group (groups claim) become administrators
ALMLIGHT_OIDC_ADMIN_GROUP=
# Create users on their first sign-in (false: only existing users may sign in)
ALMLIGHT_OIDC_ALLOW_SIGNUP=true

# Git repositories (Code page): minutes between fetches of connected repositories (0 = only on demand/webhook)
ALMLIGHT_GIT_SYNC_MINUTES=10

# AI assistant (Azure OpenAI). Off unless endpoint, key and deployment are set — the key stays on the server.
# Endpoint: the resource URL without a path, e.g. https://my-resource.openai.azure.com
# Deployment: the name you gave the model deployment in Azure AI Foundry (not the model name), e.g. gpt-4o
ALMLIGHT_AZURE_OPENAI_ENDPOINT=
ALMLIGHT_AZURE_OPENAI_API_KEY=
ALMLIGHT_AZURE_OPENAI_DEPLOYMENT=
ALMLIGHT_AZURE_OPENAI_API_VERSION=2024-10-21
# Reasoning models (GPT-5/6 and the like) need the responses API for tools — Ariadne switches to it by itself.
# ALMLIGHT_AZURE_OPENAI_RESPONSES_API_VERSION=2025-04-01-preview
# ALMLIGHT_ASSISTANT_API=auto            # chat | responses pins the surface
# ALMLIGHT_ASSISTANT_REASONING_EFFORT=   # low | medium | high for reasoning models

# A local model server (Ollama) next to Azure, chosen per conversation in the panel. From a container the
# host is reachable as host.docker.internal. The model must support tool calling (e.g. qwen3).
ALMLIGHT_OLLAMA_URL=
# ALMLIGHT_OLLAMA_MODELS=                # comma-separated allow-list; empty = everything the server has
# ALMLIGHT_ASSISTANT_DEFAULT_MODEL=      # e.g. ollama:qwen3:8b-40k — the model a new conversation starts with
