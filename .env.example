# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# Port on the host for the web app
ALMLIGHT_PORT=48080

# Database password (used by both containers)
POSTGRES_PASSWORD=change-me

# Session signing key. Leave empty to generate one automatically (persisted in the data volume).
ALMLIGHT_SECRET_KEY=

# Initial administrator password for a fresh installation. Leave empty to generate one (printed to the log once).
ALMLIGHT_ADMIN_PASSWORD=

# Load the demo project and demo users on startup (not for production)
ALMLIGHT_DEMO_DATA=false

# Set to true when served via HTTPS (reverse proxy)
ALMLIGHT_COOKIE_SECURE=false

ALMLIGHT_MAX_UPLOAD_MB=100

# Public address of the app (links in notification e-mails, single sign-on redirect), e.g. https://alm.example.com
ALMLIGHT_PUBLIC_URL=

# Notification e-mails (digest). Off unless SMTP_HOST and SMTP_FROM are set. SMTP_SECURITY: starttls | ssl | none
ALMLIGHT_SMTP_HOST=
ALMLIGHT_SMTP_PORT=587
ALMLIGHT_SMTP_USER=
ALMLIGHT_SMTP_PASSWORD=
ALMLIGHT_SMTP_FROM=
ALMLIGHT_SMTP_SECURITY=starttls

# Single sign-on via OpenID Connect (Microsoft Entra ID, Keycloak, Okta …). Off unless issuer and client id are set.
# Redirect URI to register at the identity provider: <ALMLIGHT_PUBLIC_URL>/api/v1/auth/oidc/callback
ALMLIGHT_OIDC_ISSUER=
ALMLIGHT_OIDC_CLIENT_ID=
ALMLIGHT_OIDC_CLIENT_SECRET=
ALMLIGHT_OIDC_LABEL=Single sign-on
# Members of this group (groups claim) become administrators
ALMLIGHT_OIDC_ADMIN_GROUP=
# Create users on their first sign-in (false: only existing users may sign in)
ALMLIGHT_OIDC_ALLOW_SIGNUP=true

# Git repositories (Code page): minutes between fetches of connected repositories (0 = only on demand/webhook)
ALMLIGHT_GIT_SYNC_MINUTES=10
